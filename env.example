# Top Shot Social Golf Club — environment variables
#
# Copy this file to ".env" for local development:
#     cp .env.example .env
#
# ".env" is gitignored. ".env.example" is committed as a reference.
#
# BOTH of these values are safe to expose in a browser bundle. The publishable
# key only grants access that your Row Level Security policies allow. This is
# the intended design of Supabase — do not treat it like a password.
#
# What must NEVER go in this file or in the repo: the service_role key. It
# bypasses RLS entirely. If you ever need it, it belongs in a server-side
# Edge Function secret only.

VITE_SUPABASE_URL=https://gfzkjlfcajfrcazxkybi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UhuDN4NJQbYmY57UNPrnvw_NnUEzmZG

# If the publishable key gives you trouble on an older supabase-js version,
# the legacy anon key below is an equivalent fallback. Use one or the other,
# not both — and update src/lib/supabase.js to read whichever you choose.
